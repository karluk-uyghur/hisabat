rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAccountRecord(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             data.accountName is string &&
             data.accountName.size() >= 1 &&
             data.accountName.size() <= 120 &&
             (!('password' in data) || (data.password is string && data.password.size() <= 120)) &&
             (!('flowAmount' in data) || (data.flowAmount is string && data.flowAmount.size() <= 80)) &&
             (!('openDate' in data) || (data.openDate is string && data.openDate.size() <= 30)) &&
             (!('streetName' in data) || (data.streetName is string && data.streetName.size() <= 120)) &&
             (!('houseNumber' in data) || (data.houseNumber is string && data.houseNumber.size() <= 60)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             data.months is list &&
             data.months.size() == 12 &&
             (data.months.size() == 0 || data.months[0] is bool);
    }

    match /users/{userId}/accounts/{accountId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(accountId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(accountId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'name', 'accountName', 'months', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'accountName', 'password', 'flowAmount', 'openDate', 'streetName', 'houseNumber', 'notes', 'months', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidAccountRecord(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(accountId) &&
                       isValidAccountRecord(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'accountName', 'password', 'flowAmount', 'openDate', 'streetName', 'houseNumber', 'notes', 'months', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['months', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(accountId);
    }
  }
}
